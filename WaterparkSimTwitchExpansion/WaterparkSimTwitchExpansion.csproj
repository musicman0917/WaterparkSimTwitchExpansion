<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Waterpark Simulator is an IL2CPP Unity build (GameAssembly.dll present, no
      Assembly-CSharp.dll in <Game>_Data\Managed), so this targets BepInEx 6 (IL2CPP).

      This matches BepInEx's own official IL2CPP plugin template ("dotnet new bep6plugin_il2cpp"
      from BepInEx/BepInEx.Templates): reference the BepInEx.Unity.IL2CPP NuGet package instead
      of HintPath-ing a specific game install's locally-generated interop DLLs. Earlier attempts
      at hand-rolled HintPath references to <GameDir>\BepInEx\interop\*.dll compiled against a
      real install but hit CS0656 (conflicting/incomplete NullableAttribute definitions) and a
      broken Application.quitting subscription - both go away using BepInEx's own curated
      reference assemblies instead of a raw game-generated interop dump.

      Practical effect: building this project no longer requires a local Waterpark Simulator
      install or a GameDir at all. You only need BepInEx actually installed in the game folder
      to RUN the built plugin (see install.ps1 / README for that part).
    -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WaterparkSimTwitchExpansion</AssemblyName>
    <RootNamespace>WaterparkSimTwitchExpansion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx's own curated IL2CPP/Unity engine reference assemblies (compile-only - nothing
         here gets copied into the build output). -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />

    <!-- Chat connection (Section 1). -->
    <PackageReference Include="TwitchLib.Client" Version="3.4.0" />
    <PackageReference Include="TwitchLib.Communication" Version="2.0.1" />
    <!-- JSON persistence for the point economy (Section 2). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
