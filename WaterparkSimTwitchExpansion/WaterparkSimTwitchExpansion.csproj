<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Waterpark Simulator is an IL2CPP Unity build (GameAssembly.dll present, no
      Assembly-CSharp.dll in <Game>_Data\Managed), so this targets BepInEx 6 (IL2CPP).

      Two different sources of references, for two different reasons:
        - BepInEx.Unity.IL2CPP (NuGet, from BepInEx's own feed below) - the plugin-loader API
          (BasePlugin, ConfigFile, ManualLogSource, AddComponent<T>, ...). Game-agnostic, so this
          comes from BepInEx's own curated package instead of a HintPath into a specific game's
          BepInEx\core folder - avoids CS0656 (conflicting/incomplete NullableAttribute
          definitions) that hand-rolled HintPaths to BepInEx's own assemblies hit in practice.
        - UnityEngine*.dll / Il2Cppmscorlib.dll (HintPath, from GameDir below) - the actual Unity
          engine API (GameObject, MonoBehaviour, Rigidbody, ...). This is inherently
          game/Unity-version-specific, generated by BepInEx from Waterpark Simulator's own IL2CPP
          metadata into <GameDir>\BepInEx\interop\ the first time the game runs with BepInEx
          installed - there's no generic NuGet package that could provide this part. Run the game
          once, let it sit for a bit, then close it before building.

      Point GameDir at your local Waterpark Simulator install (the folder containing
      WaterparkSimulator.exe). After the step above it must contain:
        <GameDir>\BepInEx\interop\UnityEngine*.dll
        <GameDir>\BepInEx\interop\Il2Cppmscorlib.dll

      Pass it at build time instead of hardcoding a machine-specific path:
        dotnet build -p:GameDir="F:\SteamLibrary\steamapps\common\WaterPark Simulator"
      or set a GameDir environment variable before building.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WaterparkSimTwitchExpansion</AssemblyName>
    <RootNamespace>WaterparkSimTwitchExpansion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>

    <!-- This is a library-style SDK project, so by default `dotnet build` does NOT copy NuGet
         package dependencies (TwitchLib.*, Newtonsoft.Json, their own transitive deps, ...) into
         the output folder - it only emits a .deps.json manifest describing them, meant for a
         full .NET generic host to resolve at runtime. BepInEx's plugin loader isn't that kind of
         host and never consults it, so none of those DLLs were ever actually present anywhere -
         confirmed by inspecting the deployed plugin folder directly (just the main DLL, .pdb,
         and .deps.json - nothing else), which is what actually caused the runtime
         MissingMethodException on TwitchLib's WebSocketClient constructor, not a BepInEx version
         conflict as first suspected. This forces every resolved dependency to be copied locally
         so install.ps1's "copy the whole build output" deploy step has something to copy. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx's own plugin-loader API (compile-only - nothing here gets copied into the
         build output). -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />

    <!-- Chat connection (Section 1). No explicit TwitchLib.Communication reference: it had a
         breaking rewrite between 1.x and 2.x, TwitchLib.Client 3.4.0 only floors it at ">=
         1.0.6" (evidently what it was actually built/tested against), and explicitly pinning it
         to 2.0.1 - the latest available - overrode NuGet's natural resolution and pulled in an
         API-incompatible major version, causing a runtime MissingMethodException deep inside
         TwitchClient.InitializeClient() despite everything compiling fine. Letting it resolve
         transitively from TwitchLib.Client's own dependency graph instead; its types (e.g.
         TwitchLib.Communication.Clients.WebSocketClient, used directly in TwitchChatConnector.cs)
         are still visible for compilation without a direct PackageReference. -->
    <PackageReference Include="TwitchLib.Client" Version="3.4.0" />
    <!-- JSON persistence for the point economy (Section 2). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game-specific interop assemblies (never copied into the build output - Private=false;
         they must already exist next to the game at runtime, which they do once BepInEx is
         installed there). -->
    <!-- Il2Cppmscorlib.dll embeds its own incomplete copy of System.Runtime.CompilerServices.
         NullableAttribute, which otherwise conflicts with net6.0's real one and produces CS0656.
         Extern-aliasing this reference does NOT fix it - Roslyn's lookup for this specific
         "well-known" compiler-feature attribute type isn't filtered by source-level aliases. See
         Core/Il2CppNullableAttributeWorkaround.cs for the fix that actually works. -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.Input (Chaos/PlayerInputSabotage.cs) lives in its own module in modern
         Unity, not UnityEngine.CoreModule. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GUI/GUIStyle (Core/OnScreenNotifier.cs's OnGUI) also live in their own module, not
         UnityEngine.CoreModule. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FontStyle (used by OnScreenNotifier's GUIStyle) lives here, not UnityEngine.CoreModule
         or UnityEngine.IMGUIModule. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own interop-generated script assembly (BepInEx/Il2CppInterop auto-generates
         this the same way it generates UnityEngine*.dll above - it's not the original Mono
         Assembly-CSharp.dll, which doesn't exist for an IL2CPP build). Lets us reference the
         game's actual classes directly (e.g. ToiletInteraction.PoopPrefab in
         Chaos/ChaosController.cs) instead of guessing at object names in the live scene -
         found by decompiling this same file with ILSpy and searching for "poop". -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony (HarmonyX, shipped by BepInEx itself as 0Harmony.dll) - used by
         Chaos/PlayerInputSabotage.cs to patch UnityEngine.Input without needing to know the
         game's actual player-controller script. Comes from BepInEx's own install, not NuGet -
         same reasoning as the interop assemblies above (it has to match what's actually on disk
         at runtime). -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
