<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>WaterparkSimTwitchExpansion</AssemblyName>
    <RootNamespace>WaterparkSimTwitchExpansion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>

    <!--
      Point GameDir at your local Waterpark Simulator install (the folder containing the
      game's .exe). It must already have BepInEx installed once, so it contains:
        <GameDir>\BepInEx\core\BepInEx.dll
        <GameDir>\<Game>_Data\Managed\UnityEngine*.dll

      Pass it at build time instead of hardcoding a machine-specific path:
        dotnet build -p:GameDir="C:\Games\Waterpark Simulator"
      or set a GameDir environment variable before building.
    -->
    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chat connection (Section 1). -->
    <PackageReference Include="TwitchLib.Client" Version="3.4.0" />
    <PackageReference Include="TwitchLib.Communication" Version="2.0.1" />
    <!-- JSON persistence for the point economy (Section 2). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Unity assemblies are never copied into the build output (Private=false);
         they must already exist on the user running the game. -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\WaterparkSimulator_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\WaterparkSimulator_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\WaterparkSimulator_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
